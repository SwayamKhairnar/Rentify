# ==============================================================================
# 🚀 RENTIFY ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Instructions:
# 1. Copy this file to '.env' (in the project root): cp .env.example .env
# 2. Fill in your real API credentials and database connection details below.
# 3. Your '.env' file is already added to .gitignore and will NOT be committed.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CLOUDINARY CREDENTIALS (REQUIRED FOR IMAGE UPLOADS)
# Get your free credentials from: https://cloudinary.com (Dashboard -> API Keys)
# ------------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (POSTGRESQL)
# For Local Docker: Uses standard container defaults.
# For Cloud Production (Neon.tech, Supabase, Railway): Paste your cloud DB details.
# ------------------------------------------------------------------------------
DB_HOST=postgres
DB_PORT=5432
DB_NAME=rentify
DB_USER=postgres
DB_PASS=password123

# Optional: If your cloud provider gives a single DATABASE_URL connection string:
# DATABASE_URL=postgresql://user:password@ep-xyz.us-east-2.aws.neon.tech/rentify?sslmode=require

# ------------------------------------------------------------------------------
# 3. JWT SECURITY CONFIGURATION
# Generate any random 64-character string (e.g. run: openssl rand -hex 64)
# ------------------------------------------------------------------------------
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRES_IN=7d

# ------------------------------------------------------------------------------
# 4. CORS & FRONTEND DOMAINS
# Comma-separated list of allowed frontend origins that can talk to your backend
# ------------------------------------------------------------------------------
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://your-frontend.vercel.app

# ------------------------------------------------------------------------------
# 5. FRONTEND API URL
# For Local: http://localhost:4000/api
# For Cloud (Vercel): https://your-backend.railway.app/api
# ------------------------------------------------------------------------------
VITE_API_URL=http://localhost:4000/api

# ------------------------------------------------------------------------------
# 6. SMTP EMAIL NOTIFICATIONS (OPTIONAL)
# Enable if you want live transactional emails sent for rental requests/approvals
# ------------------------------------------------------------------------------
APP_EMAIL_ENABLED=false
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=your_email@gmail.com
SPRING_MAIL_PASSWORD=your_16_digit_gmail_app_password
